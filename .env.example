# mock (default) runs the deterministic baseline with no API calls.
# live routes classification through Claude.
TRIAGE_MODE=mock

# Only read when TRIAGE_MODE=live. Never commit a real key.
# ANTHROPIC_API_KEY=sk-ant-...

TRIAGE_MODEL=claude-opus-5
TRIAGE_CONFIDENCE_FLOOR=0.7
TRIAGE_TELEMETRY=./telemetry.jsonl
PORT=3020
